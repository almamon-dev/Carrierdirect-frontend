# ==============================================================================
# BACKEND API & SERVER CONFIGURATION
# ==============================================================================
# Local development API endpoint:
VITE_API_BASE_URL=http://localhost:8000/api
# Production API endpoint:
# VITE_API_BASE_URL=https://admin.carrierdirect.io/api

# Backend Base URL (without /api)
VITE_BACKEND_URL=http://localhost:8000

# ==============================================================================
# LARAVEL REVERB WEBSOCKET (REALTIME NOTIFICATIONS & CHAT)
# ==============================================================================
VITE_REVERB_APP_KEY=your_reverb_app_key
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# ==============================================================================
# PUSH NOTIFICATIONS (VAPID / WEB PUSH)
# ==============================================================================
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# ==============================================================================
# GOOGLE OAUTH / AUTHENTICATION (OPTIONAL)
# ==============================================================================
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ==============================================================================
# REALTIME MAP TRACKING & ETA SETTINGS (OPTIONAL OVERRIDES)
# ==============================================================================
# Minimum vehicle movement required to trigger ETA recalculation (default: 0.15 km)
# VITE_ETA_MOVEMENT_THRESHOLD_KM=0.15
# Interval in milliseconds for polling/recalculating driver ETA (default: 30000 ms)
# VITE_ETA_RECALC_INTERVAL_MS=30000
